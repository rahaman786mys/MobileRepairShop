<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_bg">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Hero Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:cardCornerRadius="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/transparent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_gradient_primary"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good Morning!"
                            android:textColor="@color/muzzu_text_on_dark"
                            android:textSize="12sp"
                            android:alpha="0.8"
                            android:includeFontPadding="false" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="MuZZu Repair Shop"
                            android:textColor="@color/muzzu_text_on_dark"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateAvailable"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:visibility="gone"
                        app:icon="@android:drawable/stat_notify_sync"
                        app:iconTint="@color/muzzu_accent"
                        app:iconSize="28dp" />
                </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
            <!-- Content Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layoutAnimation="@anim/layout_fade_in_staggered">
                <!-- Today's Overview -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="TODAY'S OVERVIEW"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/muzzu_text_main"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false" />
                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_accent_line" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- KPI Cards -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:rowOrderPreserved="false">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chart_premium"
                                app:tint="@color/muzzu_success" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="PROFIT"
                                    android:textSize="11sp"
                                    android:textColor="@color/muzzu_text_sub"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                                <TextView
                                    android:id="@+id/tvTodayProfit2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="₹ 0"
                                    android:textColor="@color/muzzu_success"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardInvest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_dues_premium"
                                app:tint="@color/muzzu_primary" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="REVENUE"
                                    android:textSize="11sp"
                                    android:textColor="@color/muzzu_text_sub"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                                <TextView
                                    android:id="@+id/tvTodayInvest2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="₹ 0"
                                    android:textColor="@color/muzzu_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_list"
                                app:tint="@color/muzzu_warning" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="PENDING"
                                    android:textSize="11sp"
                                    android:textColor="@color/muzzu_text_sub"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                                <TextView
                                    android:id="@+id/tvPendingCount2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="@color/muzzu_warning"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_dues_premium"
                                app:tint="@color/muzzu_error" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="TOTAL DUES"
                                    android:textSize="11sp"
                                    android:textColor="@color/muzzu_text_sub"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                                <TextView
                                    android:id="@+id/tvCustomerDuesTotal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="₹ 0"
                                    android:textColor="@color/muzzu_error"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
                <!-- Ledger Alert Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLedgerAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/card_alert_bg"
                    app:strokeColor="@color/muzzu_error"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvLedgerAlertText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ledger mismatch detected!"
                            style="@style/TextAppearance.MuZZu.Body"
                            android:textColor="@color/muzzu_error"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:ellipsize="end" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewLedgerAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Review"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- AI Health Advisor -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiAdvisor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/transparent"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gradient_advisor"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/aiProgressIndicator"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                app:indicatorSize="80dp"
                                app:trackThickness="6dp"
                                app:indicatorColor="@color/muzzu_accent"
                                app:trackColor="#33FFFFFF"
                                android:progress="30" />
                            <TextView
                                android:id="@+id/tvAiHealthScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="30"
                                android:textColor="@color/muzzu_text_on_dark"
                                style="@style/TextAppearance.MuZZu.Title" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvAiMoveTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Steady Growth"
                                android:textColor="@color/muzzu_text_on_dark"
                                style="@style/TextAppearance.MuZZu.Title"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/tvAiRecommendation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Balance is good. Consider upselling tempered glass."
                                android:textColor="@color/muzzu_text_on_dark"
                                style="@style/TextAppearance.MuZZu.Caption"
                                android:lineHeight="16sp"
                                android:includeFontPadding="false"
                                android:maxLines="3"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Quick Actions -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="QUICK ACTIONS"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/muzzu_text_main"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false" />
                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_accent_line" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:rowOrderPreserved="false">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardService"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_plus_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="New Entry"
                                android:textSize="14sp"
                                android:textColor="@color/muzzu_text_main"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWork"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_workflow_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Active Jobs"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/muzzu_text_main"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSales"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_sales_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Direct Sales"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/muzzu_text_main"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDuesGrid"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_dues_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Dues"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/muzzu_text_main"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSuppliersGrid"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_suppliers_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Suppliers"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/muzzu_text_main"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardReportsGrid"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_chart_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Reports"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/muzzu_text_main"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMoreGrid"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1" android:layout_height="72dp"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/card_action_bg"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MuZZu.Card"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_more_premium"
                                app:tint="@color/muzzu_accent" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="More"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/muzzu_text_main"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
                <!-- Profile Missing Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMissingInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#1AF85149"
                    app:strokeColor="@color/muzzu_error"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Shop profile incomplete"
                            style="@style/TextAppearance.MuZZu.Body"
                            android:textColor="@color/muzzu_error"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:ellipsize="end" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFixMissingInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Fix Now"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
