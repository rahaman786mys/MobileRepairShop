<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_bg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Step Progress Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 of 4: Registration"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:textColor="@color/muzzu_primary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="5">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_primary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginHorizontal="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginHorizontal="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginHorizontal="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Entry Type"
                        style="@style/TextAppearance.MuZZu.Label"
                        android:layout_marginBottom="12dp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupEntryType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:checkedButton="@+id/btnTypeCustomer"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTypeCustomer"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Customer"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTypeDealer"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dealer"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="CONTACT INFORMATION"
                style="@style/TextAppearance.MuZZu.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="WhatsApp Number"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/muzzu_surface"
                app:prefixText="+91 ">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:imeOptions="actionNext"
                    style="@style/TextAppearance.MuZZu.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Full Name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/muzzu_surface">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    style="@style/TextAppearance.MuZZu.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dynamic Repair Fields -->
            <LinearLayout
                android:id="@+id/layoutRepairFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="DEVICE DETAILS"
                    style="@style/TextAppearance.MuZZu.Label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Brand"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <Spinner
                        android:id="@+id/spinnerBrand"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Model Name (e.g. iPhone 15 Pro)"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:imeOptions="actionNext"
                        style="@style/TextAppearance.MuZZu.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSPECTION PHOTOS"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPhoto1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.MuZZu.Card"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Device photo 1">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivEntryPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_plus_premium"
                            android:padding="40dp"
                            android:contentDescription="Device photo 1"
                            app:tint="@color/muzzu_border" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPhoto2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.MuZZu.Card"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Device photo 2">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivEntryPhoto2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_plus_premium"
                            android:padding="40dp"
                            android:contentDescription="Device photo 2"
                            app:tint="@color/muzzu_border" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhotos"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Take Device Photos"
                    android:textAllCaps="false" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExtraItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="Extra Items Received"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExtraItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOtherItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Specify 'Other' item"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOtherItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="City"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        style="@style/TextAppearance.MuZZu.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASSIGN SPECIALIST"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Technician"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <Spinner
                        android:id="@+id/spinnerServiceMan"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pricing -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRICING"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilChargeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Repair Charge (₹)"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etChargeAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        style="@style/TextAppearance.MuZZu.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAdvanceAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Advance Amount (₹) - Optional"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/muzzu_surface">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAdvanceAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        style="@style/TextAppearance.MuZZu.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveDraft"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Save Draft"
                        style="@style/Widget.Material3.Button.TonalButton" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveEntry"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1.5"
                        android:layout_marginStart="8dp"
                        android:text="Register Entry"
                        style="@style/Widget.MuZZu.Button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
