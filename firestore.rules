rules_version = '2';

// Firestore security rules for project mobile-shop-7922a.
//
// Model: the app (shop owners + workers) and the Founder Console both authenticate
// with Firebase Auth, then read/write the shared collections below. Every rule
// therefore requires an authenticated user. This is intentionally broad for a
// single-founder deployment; see the note at the bottom for per-tenant hardening.
//
// Deploy:  firebase deploy --only firestore:rules --project mobile-shop-7922a
// Or paste the /tickets block into Firebase Console -> Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Support / change-request tickets: app users create them, founder reviews.
    // NOTE: create is intentionally open because the app's Firebase Auth session is
    // currently unreliable (see auth issue). Every ticket still carries the owner's
    // id/email/phone in its data. Reading/managing stays founder-only (auth required).
    // TODO: revert create to `if signedIn()` once app authentication is fixed.
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }

    // Owner + shop records. The app writes these WITHOUT an auth session (its
    // Firebase auth is currently unreliable), so writes are open; reads stay
    // founder-only. TODO: require signedIn() for writes once app auth is fixed.
    match /owners/{ownerId} {
      allow read: if signedIn();
      allow write: if true;
    }

    // Workers, login audit, sessions — same rationale (app writes without auth).
    match /workers/{workerId} {
      allow read: if signedIn();
      allow write: if true;
    }
    match /login_logs/{logId} {
      allow read: if signedIn();
      allow write: if true;
    }
    match /auth_sessions/{sessionId} {
      allow read: if signedIn();
      allow write: if true;
    }

    // Monetization + operations (managed from the Founder Console).
    match /licenses/{licenseId} {
      allow read, write: if signedIn();
    }
    match /subscriptions/{subscriptionId} {
      allow read, write: if signedIn();
    }
    match /payments/{paymentId} {
      allow read, write: if signedIn();
    }
    match /repairs/{repairId} {
      allow read, write: if signedIn();
    }
    match /whatsapp_logs/{logId} {
      allow read, write: if signedIn();
    }
  }
}

// NOTE ON HARDENING: the rules above let any authenticated user read/write these
// collections. For stricter multi-tenant isolation you would, for example, gate
// licenses/subscriptions/payments and cross-owner reads behind a founder claim
// (request.auth.token.founder == true) and restrict owners/{id} to the matching
// user. Ask before tightening so existing app flows are not broken.
