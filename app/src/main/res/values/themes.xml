<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobileRepairShop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core Colors -->
        <item name="colorPrimary">@color/muzzu_primary</item>
        <item name="colorOnPrimary">@color/muzzu_text_on_dark</item>
        <item name="colorSecondary">@color/muzzu_accent</item>
        <item name="android:windowBackground">@color/muzzu_bg</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/inter</item>

        <!-- Global Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.MuZZu.Card</item>
        <item name="materialButtonStyle">@style/Widget.MuZZu.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MuZZu.Button.Outlined</item>
        <item name="chipStyle">@style/Widget.MuZZu.Chip</item>
    </style>

    <!-- Premium Card Style -->
    <style name="Widget.MuZZu.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/muzzu_border</item>
        <item name="cardBackgroundColor">@color/muzzu_surface</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Premium Button Style -->
    <style name="Widget.MuZZu.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:stateListAnimator">@animator/button_scale</item>
    </style>

    <style name="Widget.MuZZu.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:stateListAnimator">@animator/button_scale</item>
    </style>

    <!-- Premium Chip Style -->
    <style name="Widget.MuZZu.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="cornerRadius">4dp</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Typography Hierarchy -->
    <style name="TextAppearance.MuZZu.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muzzu_text_main</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.MuZZu.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muzzu_text_main</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.MuZZu.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muzzu_text_main</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.MuZZu.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/muzzu_text_main</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.MuZZu.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/muzzu_text_sub</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.MuZZu.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/muzzu_text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Bottom Nav Styles -->
    <style name="BottomNavText" parent="TextAppearance.Material3.LabelMedium" />
    <style name="BottomNavText.Active">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BottomNavText.Inactive">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ThemeOverlay.MuZZu.UpdateDialog" parent="ThemeOverlay.Material3.Dark">
        <item name="android:windowBackground">@color/muzzu_bg</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
