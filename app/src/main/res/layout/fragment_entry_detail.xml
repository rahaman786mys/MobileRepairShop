<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Back"
                android:textAllCaps="false" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Customer Details"
                        android:textColor="@color/muzzu_primary"
                        style="@style/TextAppearance.MuZZu.Title" />

                    <TextView
                        android:id="@+id/tvDetailCustomer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailMobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="City: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailDealer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dealer: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailServiceMan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Man: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entry: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailFault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fault: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailCharge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Charge: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                    <TextView
                        android:id="@+id/tvDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: -"
                        style="@style/TextAppearance.MuZZu.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Workflow"
                        android:textAppearance="@style/TextAppearance.MuZZu.Title"
                        android:textColor="@color/muzzu_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpareParts"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:text="Spare Parts" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHandover"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:text="Handover" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
