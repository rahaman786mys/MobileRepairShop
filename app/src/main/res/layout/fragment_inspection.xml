<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_bg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Step Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 of 5: Diagnostics"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:textColor="@color/muzzu_primary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="5">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="@color/muzzu_primary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginHorizontal="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginHorizontal="2dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/muzzu_border" android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OBSERVED FAULTS"
                        style="@style/TextAppearance.MuZZu.Label"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCommonFaults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layoutAnimation="@anim/layout_fall_down" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="Custom observation..."
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/muzzu_surface">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomFault"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="3"
                            style="@style/TextAppearance.MuZZu.Body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIAGNOSTIC PHOTO"
                        style="@style/TextAppearance.MuZZu.Label"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        style="@style/Widget.MuZZu.Card"
                        app:cardBackgroundColor="@color/muzzu_surface">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivInspectionPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_plus_premium"
                            android:padding="60dp"
                            app:tint="@color/muzzu_border" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTakeInspectionPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Capture Photo"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:textAllCaps="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiAnalyse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="AI Fault Analysis"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        app:icon="@drawable/ic_chart_premium" />

                    <TextView
                        android:id="@+id/tvAiSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        android:padding="16dp"
                        android:background="@drawable/bg_gradient_advisor"
                        android:textColor="#B0C4DE"
                        style="@style/TextAppearance.MuZZu.Caption"
                        android:lineHeight="18sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveInspection"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:text="Save Diagnostics"
                style="@style/Widget.MuZZu.Button" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
