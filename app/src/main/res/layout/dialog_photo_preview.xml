<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_bg"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Photo preview" />

    <ImageButton
        android:id="@+id/btnClosePreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close preview"
        app:tint="@color/muzzu_text_on_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="24dp"
        android:background="@drawable/bg_gradient_advisor"
        android:alpha="0.9">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/Widget.MuZZu.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Retake"
            app:strokeColor="@color/muzzu_text_on_dark"
            android:textColor="@color/muzzu_text_on_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkIssue"
            style="@style/Widget.MuZZu.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Mark"
            android:layout_marginStart="12dp"
            app:strokeColor="@color/muzzu_accent"
            android:textColor="@color/muzzu_accent"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="@color/muzzu_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.MuZZu.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Delete"
            android:layout_marginStart="12dp"
            app:backgroundTint="@color/muzzu_error"
            android:textColor="@color/muzzu_text_on_dark" />
    </LinearLayout>

</FrameLayout>
