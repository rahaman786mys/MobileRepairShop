# Ignore everything in these folders
.gradle/
app/build/
build/
bin/
gen/
out/

# IDE files
.idea/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# Local configuration
local.properties
captures/
.externalNativeBuild/
.cxx/

# Android files
*.apk
*.ap_
*.dex
*.class

# Debug keystore is committed intentionally so local + CI builds share ONE
# signing identity whose SHA-1 is registered in Firebase (fixes Google Sign-In
# code 10 on CI-distributed builds). This is a DEBUG keystore only.
# app/debug.keystore
.kotlin/
*.msi

# Temporary compile/test output
compile_output.txt
*.log

debug_keystore_base64.txt



# Large dumps / heap snapshots
*.hprof
*.prof

# Founder Console — LOCAL ONLY, NEVER PUSH
founder-dashboard.html
start-server.bat
