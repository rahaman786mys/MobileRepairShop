<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Today's Overview Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingStart="8dp"
                android:text="TODAY'S OVERVIEW"
                style="@style/TextAppearance.MuZZu.Label"
                android:background="@drawable/bg_border_left_accent" />

            <!-- KPI Cards Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <!-- Profit KPI -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PROFIT"
                            style="@style/TextAppearance.MuZZu.Caption"
                            android:textAllCaps="true"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tvTodayProfit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₹ 0"
                            android:textColor="@color/muzzu_success"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Revenue KPI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInvest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="REVENUE"
                            style="@style/TextAppearance.MuZZu.Caption"
                            android:textAllCaps="true"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tvTodayInvest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₹ 0"
                            android:textColor="@color/muzzu_primary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pending KPI -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PENDING"
                            style="@style/TextAppearance.MuZZu.Caption"
                            android:textAllCaps="true"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/muzzu_warning"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dues KPI -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TOTAL DUES"
                            style="@style/TextAppearance.MuZZu.Caption"
                            android:textAllCaps="true"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tvCustomerDuesTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₹ 0"
                            android:textColor="@color/muzzu_error"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Ledger Alert Banner (Nightly Auditor) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLedgerAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_alert_bg"
                app:strokeColor="@color/muzzu_error"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvLedgerAlertText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ledger mismatch detected!"
                        style="@style/TextAppearance.MuZZu.Body"
                        android:textColor="@color/muzzu_error"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:ellipsize="end" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewLedgerAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Review"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI Health Advisor Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiAdvisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="@color/transparent"
                app:strokeWidth="0dp"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_advisor"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp">
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/aiProgressIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            app:indicatorSize="80dp"
                            app:trackThickness="6dp"
                            app:indicatorColor="@color/muzzu_accent"
                            app:trackColor="#33FFFFFF"
                            android:progress="30" />
                        <TextView
                            android:id="@+id/tvAiHealthScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="30"
                            android:textColor="@color/muzzu_text_on_dark"
                            style="@style/TextAppearance.MuZZu.Title" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvAiMoveTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Steady Growth"
                            android:textColor="@color/muzzu_text_on_dark"
                            style="@style/TextAppearance.MuZZu.Title"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tvAiRecommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                    android:text="Balance is good. Consider upselling tempered glass."
                    android:textColor="@color/muzzu_text_on_dark"
                            style="@style/TextAppearance.MuZZu.Caption"
                            android:lineHeight="16sp"
                            android:includeFontPadding="false"
                            android:maxLines="3"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:paddingStart="8dp"
                android:text="QUICK ACTIONS"
                style="@style/TextAppearance.MuZZu.Label"
                android:background="@drawable/bg_border_left_accent"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Quick Action Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <!-- Action: New Entry -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardService"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_plus_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="New Entry"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            style="@style/TextAppearance.MuZZu.Label"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Active Jobs -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWork"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_workflow_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Active Jobs"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            style="@style/TextAppearance.MuZZu.Label"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Direct Sales -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSales"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sales_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Direct Sales"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Dues -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDuesGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_dues_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dues"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Suppliers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuppliersGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_suppliers_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Suppliers"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Reports -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportsGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chart_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Reports"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: More -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMoreGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/card_action_bg"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MuZZu.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_more_premium"
                            app:tint="@color/muzzu_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="More"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Profile Missing Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMissingInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1AF85149"
                app:strokeColor="@color/muzzu_error"
                style="@style/Widget.MuZZu.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shop profile incomplete"
                        style="@style/TextAppearance.MuZZu.Body"
                        android:textColor="@color/muzzu_error"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:ellipsize="end" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFixMissingInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Fix Now"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
