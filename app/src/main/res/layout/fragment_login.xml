<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muzzu_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Logo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_circle_sunken"
            android:padding="14dp"
            android:src="@drawable/ic_service_premium"
            android:contentDescription="MuZZu Tech logo"
            app:tint="@color/muzzu_accent"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MuZZu Tech"
            style="@style/TextAppearance.MuZZu.Display"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Professional Repair Suite"
            style="@style/TextAppearance.MuZZu.Label"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp" />

        <!-- Register / Login Toggle -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAuthMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="28dp"
            app:singleSelection="true"
            app:checkedButton="@id/btnToggleRegister">

            <Button
                android:id="@+id/btnToggleRegister"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Register" />

            <Button
                android:id="@+id/btnToggleLogin"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Login" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- === GOOGLE === -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnGoogleSync"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.MuZZu.Card"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_google" />

                <TextView
                    android:id="@+id/tvGoogleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Continue with Google"
                    style="@style/TextAppearance.MuZZu.Body"
                    android:textStyle="bold"
                    android:textColor="@color/muzzu_text_main" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- WhatsApp option removed from the UI. Kept hidden so existing view
             bindings still resolve without touching LoginFragment. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:visibility="gone"
            style="@style/Widget.MuZZu.Card">

            <TextView
                android:id="@+id/tvWhatsAppLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- === PHONE OTP === -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnPhoneOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.MuZZu.Card"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="📱"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvPhoneOtpLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Phone Number OTP"
                    style="@style/TextAppearance.MuZZu.Body"
                    android:textStyle="bold"
                    android:textColor="@color/muzzu_text_main" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- === WORKER SECTION (Login mode only) === -->
        <LinearLayout
            android:id="@+id/layoutWorker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="— OR WORKER LOGIN —"
                style="@style/TextAppearance.MuZZu.Label"
                android:textSize="10sp"
                android:textColor="#888888" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWorkerPhone"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email or Phone"
                app:boxStrokeWidth="1dp"
                app:boxStrokeColor="@color/muzzu_border">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWorkerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWorkerPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Password"
                app:passwordToggleEnabled="true"
                app:boxStrokeWidth="1dp"
                app:boxStrokeColor="@color/muzzu_border">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWorkerPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWorkerLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Login as Worker"
                style="@style/Widget.MuZZu.Button" />
        </LinearLayout>

        <!-- === PHONE INPUT SECTION (when Phone OTP is clicked) === -->
        <LinearLayout
            android:id="@+id/layoutPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="— ENTER PHONE NUMBER —"
                style="@style/TextAppearance.MuZZu.Label"
                android:textSize="10sp"
                android:textColor="#888888" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMobileNumber"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mobile Number"
                app:prefixText="+91 "
                app:boxStrokeWidth="1dp"
                app:boxStrokeColor="@color/muzzu_border">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Send OTP"
                style="@style/Widget.MuZZu.Button" />
        </LinearLayout>

        <!-- === OTP VERIFICATION SECTION === -->
        <LinearLayout
            android:id="@+id/layoutOtpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOtpSentTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="OTP sent"
                style="@style/TextAppearance.MuZZu.Body" />

            <TextView
                android:id="@+id/tvOtpPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:text=""
                style="@style/TextAppearance.MuZZu.Label"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter 4-digit code"
                app:boxStrokeWidth="1dp"
                app:boxStrokeColor="@color/muzzu_border">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textAlignment="center"
                    android:letterSpacing="0.2"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Verify &amp; Continue"
                style="@style/Widget.MuZZu.Button" />

            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="Resend Code"
                style="@style/TextAppearance.MuZZu.Label"
                android:textColor="@color/muzzu_accent" />
        </LinearLayout>

        <!-- === REGISTRATION DETAILS (after OTP verify) === -->
        <ScrollView
            android:id="@+id/layoutRegistrationDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:text="— COMPLETE YOUR PROFILE —"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:textSize="10sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvRegPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:text="+91 "
                    style="@style/TextAppearance.MuZZu.Label"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFullName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name *"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="@color/muzzu_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Email"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="@color/muzzu_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:clickable="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyEmailGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:text="🔵 Verify Email via Google Sign-In"
                    android:textSize="12sp"
                    style="@style/Widget.MuZZu.Button" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilShopName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Shop Name *"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="@color/muzzu_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etShopName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilShopAddress"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Shop Address *"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="@color/muzzu_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGst"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="GST Number (optional)"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="@color/muzzu_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGst"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Photo section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Profile Photo"
                    style="@style/TextAppearance.MuZZu.Label"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePreview"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_sunken"
                        android:src="@drawable/ic_dashboard"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTakePhoto"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="📷 Take Photo"
                        style="@style/Widget.MuZZu.Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadPhoto"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="📁 Upload"
                        style="@style/Widget.MuZZu.Button" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="Create Account &amp; Go Inside"
                    style="@style/Widget.MuZZu.Button" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:indeterminateTint="@color/muzzu_accent"/>

    </LinearLayout>
</ScrollView>
